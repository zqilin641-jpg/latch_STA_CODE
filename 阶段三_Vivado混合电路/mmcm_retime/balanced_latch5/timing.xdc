create_clock -name common_clock -period 10 -waveform {0 5} [get_ports clk_in]
set_clock_uncertainty 0.2 [get_clocks common_clock]
set_input_delay -clock common_clock -max 2.0 [get_ports {data_in[*]}]
set_input_delay -clock common_clock -min 0.2 [get_ports {data_in[*]}]
set_output_delay -clock common_clock -max 2.0 [get_ports {result[*] valid_out}]
set_output_delay -clock common_clock -min 0.2 [get_ports {result[*] valid_out}]
set_false_path -from [get_ports reset]
set_property IOSTANDARD LVCMOS33 [get_ports *]
set_property PACKAGE_PIN M18 [get_ports {clk_in}]
set_property PACKAGE_PIN U14 [get_ports {data_in[0]}]
set_property PACKAGE_PIN W16 [get_ports {data_in[10]}]
set_property PACKAGE_PIN V17 [get_ports {data_in[11]}]
set_property PACKAGE_PIN V16 [get_ports {data_in[12]}]
set_property PACKAGE_PIN U18 [get_ports {data_in[13]}]
set_property PACKAGE_PIN U17 [get_ports {data_in[14]}]
set_property PACKAGE_PIN T18 [get_ports {data_in[15]}]
set_property PACKAGE_PIN V14 [get_ports {data_in[1]}]
set_property PACKAGE_PIN V13 [get_ports {data_in[2]}]
set_property PACKAGE_PIN U16 [get_ports {data_in[3]}]
set_property PACKAGE_PIN U15 [get_ports {data_in[4]}]
set_property PACKAGE_PIN W14 [get_ports {data_in[5]}]
set_property PACKAGE_PIN W13 [get_ports {data_in[6]}]
set_property PACKAGE_PIN W15 [get_ports {data_in[7]}]
set_property PACKAGE_PIN V15 [get_ports {data_in[8]}]
set_property PACKAGE_PIN W17 [get_ports {data_in[9]}]
set_property PACKAGE_PIN T17 [get_ports {reset}]
set_property PACKAGE_PIN W19 [get_ports {result[0]}]
set_property PACKAGE_PIN M19 [get_ports {result[10]}]
set_property PACKAGE_PIN R19 [get_ports {result[11]}]
set_property PACKAGE_PIN P19 [get_ports {result[12]}]
set_property PACKAGE_PIN N19 [get_ports {result[13]}]
set_property PACKAGE_PIN N18 [get_ports {result[14]}]
set_property PACKAGE_PIN K18 [get_ports {result[15]}]
set_property PACKAGE_PIN W18 [get_ports {result[1]}]
set_property PACKAGE_PIN V19 [get_ports {result[2]}]
set_property PACKAGE_PIN U19 [get_ports {result[3]}]
set_property PACKAGE_PIN R18 [get_ports {result[4]}]
set_property PACKAGE_PIN P18 [get_ports {result[5]}]
set_property PACKAGE_PIN P17 [get_ports {result[6]}]
set_property PACKAGE_PIN N17 [get_ports {result[7]}]
set_property PACKAGE_PIN K17 [get_ports {result[8]}]
set_property PACKAGE_PIN L17 [get_ports {result[9]}]
set_property PACKAGE_PIN L18 [get_ports {valid_out}]

set_property IOB TRUE [get_cells -filter {REF_NAME == FDCE} {output_ff_* valid_ff_04}]

set_property SLEW FAST [get_ports {result[*] valid_out}]
set_clock_uncertainty 0.2 [get_clocks -include_generated_clocks common_clock]
